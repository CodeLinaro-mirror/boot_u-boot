#include "ipq5332-default.dts"

/ {
	config_name = "config@db-mi01.1", "config-db-mi01.1";

	soc: soc {
		tlmm: pinctrl@1000000 {
			mdio_pinmux: mdio {
				mdc {
					pins = "GPIO_27";
					function = "mdc_1";
					drive-strength = <DRIVE_STRENGTH_8MA>;
					bias-disable;
				};

				mdio {
					pins = "GPIO_28";
					function = "mdio_1";
					drive-strength = <DRIVE_STRENGTH_8MA>;
					bias-pull-up;
				};
			};

			phy_rst_pinmux: phy_rst {
				qti_aquantia_p1_rst {
					pins = "GPIO_22";
					drive-strength = <DRIVE_STRENGTH_8MA>;
					bias-pull-up;
				};

				qti_aquantia_p2_rst {
					pins = "GPIO_24";
					drive-strength = <DRIVE_STRENGTH_8MA>;
					bias-pull-up;
				};
			};
		};

		mdio: mdio@90000 {
			pinctrl-names = "default";
			pinctrl-0 = <&mdio_pinmux>;
			status = "okay";

			phy0: phy@8 {
				phy-reset-gpio = <&tlmm 22 0>;
				reg = <8>;
				phy_id = <2>;
				phy-mode = "usxgmii";
				id = <1>;
				uniphy_id = <0>;
				uniphy_type = <0>;
				xgmac;
			};

			phy1: phy@0 {
				phy-reset-gpio = <&tlmm 24 0>;
				reg = <0>;
				phy_id = <2>;
				phy-mode = "usxgmii";
				id = <2>;
				uniphy_id = <1>;
				uniphy_type = <0>;
				xgmac;
			};
		};

		ethernet: nss-switch {
			phy-handle0 = <&phy0>;
			phy-handle1 = <&phy1>;
			status = "okay";
		};
	};
};
