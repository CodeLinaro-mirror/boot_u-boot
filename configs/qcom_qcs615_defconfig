# Configuration for building U-Boot to be flashed
# to the uefi partition of QCS615 dev boards with
# the "Linux Embedded" partition layout (which have
# a dedicated "uefi" partition for edk2/U-Boot)

#include "qcom_defconfig"

# Otherwise buildman thinks this isn't an ARM platform
CONFIG_ARM=y

CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_BASE=0x880000
CONFIG_DEBUG_UART_MSM_GENI=y
CONFIG_DEBUG_UART_CLOCK=7372800

CONFIG_DEFAULT_DEVICE_TREE="qcom/qcs615-ride"

# MMC is disabled
CONFIG_MMC_SDHCI_MSM=n

CONFIG_REMAKE_ELF=y
CONFIG_OF_LIVE_QCS615=y

CONFIG_PARTITION_TYPE_GUID=y
CONFIG_ENV_IS_IN_SCSI=y
CONFIG_SCSI_ENV_PART_TYPE_GUID="bc0330eb-3410-4951-a617-03898dbe3372"

# Address where U-Boot will be loaded
CONFIG_TEXT_BASE=0x9fc00000
CONFIG_SYSRESET_QCOM_PSCI=y

CONFIG_FASTBOOT_BUF_ADDR=0xa1600000

CONFIG_CMD_GPT=y
CONFIG_FASTBOOT_CMD_OEM_FORMAT=y

CONFIG_SYS_FDT_PAD=0x4000
